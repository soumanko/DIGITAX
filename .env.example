# ============================================================================
# DIGITAX — Environment Variables Template
#
# Copy this file to .env.local and configure your actual project credentials:
#   cp .env.example .env.local
#
# NEVER commit .env.local or secret keys into source control!
# ============================================================================

# ----------------------------------------------------------------------------
# 1. Supabase Public Project Configuration (Required)
# Available in your Supabase Dashboard: Project Settings -> API
# ----------------------------------------------------------------------------
# The unique REST API URL of your Supabase project (HTTPS)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# The client-side anon / public API key (Safe for public browser & SSR middleware usage)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-publishable-key-here

# ----------------------------------------------------------------------------
# 2. Supabase Server Service Role Key (Required only for server-side admin ops)
# NEVER expose this key in client-side code, git commits, or public env files!
# ----------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-secret-key-here

# ----------------------------------------------------------------------------
# 3. GNANI AI & OCR Service Integrations (Optional)
# If unconfigured, DIGITAX uses deterministic grounded calculation engines.
# ----------------------------------------------------------------------------
GNANI_EVON_API_KEY=your-gnani-evon-api-key-here
GNANI_EVON_API_URL=https://api.gnani.ai/evon/v3.3
GNANI_EVON_MODEL_ID=evon-v3.3
OCR_API_KEY=your-ocr-api-key-here
OCR_API_URL=https://api.gnani.ai/ocr/v1/extract

